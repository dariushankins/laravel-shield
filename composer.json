{
    "name": "dariushankins/shield",
    "description": "A HTTP basic auth middleware for Laravel",
    "license": "MIT",
    "keywords": [
        "auth",
        "basic",
        "http",
        "laravel",
        "middleware",
        "shield"
    ],
    "authors": [
        {
            "name": "Vincent Klaiber",
            "homepage": "https://github.com/Dariushankins/laravel-shield"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5.50",
        "symfony/translation": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Dariushankins\\Shield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dariushankins\\Tests\\Shield\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-laravel13": "10.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Dariushankins\\Shield\\ShieldServiceProvider"
            ]
        }
    }
}
